{
  "name": "@haude/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "pnpm --filter=@haude/types build && next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "clean": "rm -rf .next node_modules/.cache",
    "analyze": "ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "dependencies": {
    "@haude/types": "workspace:*",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.560.0",
    "next": "^15.5.29",
    "next-intl": "^4.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-social-media-embed": "^2.5.18",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^5.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "agentation": "^2.3.3",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
